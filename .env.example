# ─── BOT DIFUSIÓN MASIVA WHATSAPP ─────────────────────────────
# ID del Google Sheet público (del link https://docs.google.com/spreadsheets/d/ESTE_ID/edit)
SHEET_ID=
# GID de la pestaña (0 = primera hoja)
SHEET_GID=0
# Cada cuántos minutos el bot recarga solo el Sheet (0 = desactivado)
SHEET_REFRESH_MIN=2

# Directorio de datos persistentes. Local: dejar vacío.
# En Railway: DATA_DIR=/app/data (con un Volume montado en /app/data)
DATA_DIR=
PLANTILLA_DEFAULT=Hola {nombre} 👋, te contactamos por el caso del {fecha_sucedio} (registrado el {fecha_subida}). Queríamos contarte las novedades. ¡Gracias por tu confianza!

# Panel web
PORT=5000
PANEL_PASSWORD=
BOT_NAME=DifusionBot
GROQ_API_KEY=
